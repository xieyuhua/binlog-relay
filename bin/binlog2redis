#!/usr/bin/env php
<?php
/**
 * binlog2redis —— 单文件 binlog → Redis Stream 服务
 *
 * 只做一件事：连上 MySQL 读 binlog → 按配置过滤表/列 → 写 Redis Stream
 *
 * 特性：
 * - 零 Composer 依赖（内嵌 binlog 解析器，见 src/Replication）
 * - 单文件可执行：php binlog2redis start
 * - 点位可存 Redis 或文件，支持崩溃后续传
 * - 同一事件可按规则扇出到多个 topic
 *
 * 用法：
 *   binlog2redis start                 启动（Ctrl+C / SIGTERM 优雅退出）
 *   binlog2redis once --seconds=5      消费指定秒数后退出
 *   binlog2redis status                查看点位
 *   binlog2redis reset-position --force 重置点位
 *   binlog2redis check                 连通性自检
 *
 * 配置：默认读 ./config/binlog2redis.php，可用 RELAY_CONFIG 指定。
 */

declare(strict_types=1);

define('RELAY_ROOT', str_starts_with(__FILE__, 'phar://') ? __DIR__ : dirname(__DIR__));

require RELAY_ROOT . '/src/bootstrap.php';

use BinlogRelay\Checkpoint\FileStore;
use BinlogRelay\Checkpoint\PositionManager;
use BinlogRelay\Checkpoint\RedisStore;
use BinlogRelay\Checkpoint\StoreInterface;
use BinlogRelay\Event\Filter;
use BinlogRelay\Relay\Connector;
use BinlogRelay\Standalone\RelaySubscriber;
use BinlogRelay\Standalone\Runner;
use BinlogRelay\Standalone\StreamWriter;
use BinlogRelay\Support\Logger;

$config = load_config();
date_default_timezone_set($config['timezone'] ?? 'Asia/Shanghai');

$argv = $_SERVER['argv'] ?? [];
array_shift($argv);
$command = $argv[0] ?? 'start';
$options = parse_options(array_slice($argv, 1));

try {
    switch ($command) {
        case 'start':
        case 'once':
            run_service($config, $command, $options);
            break;
        case 'status':
            show_status($config);
            break;
        case 'reset-position':
            reset_position($config, $options);
            break;
        case 'fullsync':
            exit(run_fullsync($config, $options));
        case 'check':
            exit(run_check($config));
        case 'help':
        case '--help':
        case '-h':
            usage();
            break;
        default:
            fwrite(STDERR, "未知命令：{$command}\n\n");
            usage();
            exit(1);
    }
} catch (Throwable $e) {
    fwrite(STDERR, '错误：' . $e->getMessage() . PHP_EOL);

    // 致命错误也要告警：进程即将退出，这是最需要人工介入的场景。
    // 告警失败不能掩盖原始错误，所以整个告警过程包在 try 里。
    try {
        \BinlogRelay\Alert\NotificationManager::fromConfig(
            $config['alert'] ?? [],
            make_logger($config)
        )->alert(
            'fatal',
            'binlog2redis 异常退出',
            $e->getMessage(),
            [
                '命令' => $command,
                '异常' => get_class($e),
                '位置' => basename($e->getFile()) . ':' . $e->getLine(),
                '主机' => gethostname() ?: 'unknown',
            ]
        );
    } catch (Throwable) {
    }

    exit(1);
}

/* ===================== 命令 ===================== */

function run_service(array $config, string $command, array $options): void
{
    $logger = make_logger($config);
    $positions = make_positions(make_store($config), $logger, $config);
    $positions->lock();

    BinlogRelay\Event\EventBuilder::onMissingKey(fn(string $msg) => $logger->warning($msg));

    $writer = new StreamWriter($config, $logger);
    $writer->boot();

    $subscriber = new RelaySubscriber(
        $writer,
        Filter::fromConfig($config['filter'] ?? []),
        $positions,
        $logger,
        (int)($config['batch_size'] ?? 200),
        Connector::makeProjector($config, $logger)
    );

    $deadline = $command === 'once'
        ? microtime(true) + (float)($options['seconds'] ?? 5)
        : null;

    $runner = new Runner($config, $logger, $positions, $subscriber);
    install_signals($runner);

    try {
        $runner->run($deadline);
    } finally {
        $positions->flush();
        $positions->unlock();
    }
}

function show_status(array $config): void
{
    BinlogRelay\Console\CheckpointCommand::status(make_store($config), '将从最新 binlog 末尾开始');
}

function reset_position(array $config, array $options): void
{
    exit(BinlogRelay\Console\CheckpointCommand::reset(make_store($config), isset($options['force'])));
}

/**
 * 全量同步：把现存数据以快照形式推一遍，并记录起始位点
 *
 * 用法：
 *   binlog2redis fullsync                 同步配置里 filter 指定的库表
 *   binlog2redis fullsync --tables=orders 只同步指定表
 *   binlog2redis fullsync --dry-run       只列出表和行数，不推送
 *
 * 完成后直接启动 `binlog2redis start` 即可接续增量（点位已对齐）。
 */
function run_fullsync(array $config, array $options): int
{
    $logger = make_logger($config);
    $mysql = $config['mysql'];

    // ---- 1. 先记录位点（必须在快照之前，否则会丢快照期间的变更）----
    $store = make_store($config);
    $positions = make_positions($store, $logger, $config);

    $pdo = new PDO(
        sprintf('mysql:host=%s;port=%d;charset=%s', $mysql['host'], $mysql['port'], $mysql['charset'] ?? 'utf8mb4'),
        (string)$mysql['user'],
        (string)$mysql['password'],
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_TIMEOUT => 10]
    );

    $status = $pdo->query('SHOW MASTER STATUS')->fetch(PDO::FETCH_ASSOC);
    if ($status === false) {
        // MySQL 8.4 起改名
        $status = $pdo->query('SHOW BINARY LOG STATUS')->fetch(PDO::FETCH_ASSOC);
    }
    if ($status === false || !isset($status['File'])) {
        fwrite(STDERR, "无法读取 binlog 位点，请确认 log_bin 已开启且有 REPLICATION CLIENT 权限\n");
        return 1;
    }
    $startFile = (string)$status['File'];
    $startPos = (string)$status['Position'];

    $dryRun = isset($options['dry-run']);
    if (!$dryRun) {
        if (!$store->acquireLock('fullsync:' . getmypid(), 600)) {
            fwrite(STDERR, "点位被占用（relay 可能在运行）。全量同步请先停止 relay\n");
            return 2;
        }
        $store->save(new \BinlogRelay\Checkpoint\Checkpoint($startFile, $startPos, '', time(), 0, 'fullsync'));
        $store->releaseLock('fullsync:' . getmypid());
        $logger->info("起始位点已记录：{$startFile}:{$startPos}");
    }

    // ---- 2. 列出待同步的表 ----
    $filter = $config['filter'] ?? [];
    $onlyTables = array_filter(array_map('trim', explode(',', (string)($options['tables'] ?? ''))));
    $syncer = new \BinlogRelay\FullSync\FullSyncer(
        $pdo,
        $logger,
        (int)($config['fullsync']['batch_size'] ?? 1000)
    );

    // include_views：是否把视图也纳入全量同步
    $includeViews = !empty($config['fullsync']['include_views']);
    $tables = $syncer->listTables(
        $filter['databases'] ?? [],
        $onlyTables !== [] ? $onlyTables : ($filter['tables'] ?? []),
        $includeViews
    );

    if ($tables === []) {
        fwrite(STDERR, "没有匹配到需要同步的表，请检查 filter.databases / filter.tables\n");
        return 1;
    }

    $logger->info(sprintf('待同步 %d 个对象', count($tables)));
    if ($dryRun) {
        foreach ($tables as $t) {
            $kind = ($t['type'] ?? 'table') === 'view' ? '[视图] ' : '';
            echo "  {$kind}{$t['database']}.{$t['table']}\n";
        }
        echo "\n（--dry-run，未推送任何数据）\n";
        return 0;
    }

    // ---- 3. 逐表推送快照 ----
    $writer = new \BinlogRelay\Standalone\StreamWriter($config, $logger);
    $writer->boot();

    $grandTotal = 0;
    $startedAt = microtime(true);

    foreach ($tables as $i => $t) {
        $db = $t['database'];
        $tb = $t['table'];
        $n = $syncer->syncTable($db, $tb, function (array $changes) use ($writer): void {
            // 快照消息与增量格式完全一致，下游无需区分
            $writer->handle($changes);
        });
        $grandTotal += $n;
        $logger->info(sprintf(
            '[%d/%d] %s.%s 完成，%d 行',
            $i + 1,
            count($tables),
            $db,
            $tb,
            $n
        ));
    }

    $cost = microtime(true) - $startedAt;
    $logger->info(sprintf(
        '全量同步完成：%d 张表 / %d 行 / %.1f 秒（%.0f 行/秒）',
        count($tables),
        $grandTotal,
        $cost,
        $grandTotal / max($cost, 0.001)
    ));
    echo "\n下一步：binlog2redis start（会从 {$startFile}:{$startPos} 开始回放增量）\n";

    return 0;
}

function run_check(array $config): int
{
    $check = BinlogRelay\Console\CheckCommand::mysql($config)
        ->checkpoint(make_store($config));

    try {
        $cfg = $config['redis'];
        $r = new Redis();
        $r->connect((string)$cfg['host'], (int)$cfg['port'], 2.0);
        if ((string)($cfg['password'] ?? '') !== '') {
            $r->auth((string)$cfg['password']);
        }
        $r->ping();
        $topics = $cfg['topics'] ?? [['stream' => $cfg['stream'] ?? 'binlog:events']];
        $check->ok('Redis 连接成功')
            ->ok('写入目标：' . implode(', ', array_column($topics, 'stream')));
    } catch (Throwable $e) {
        $check->fail('Redis：' . $e->getMessage());
    }

    return $check->result();
}

/* ===================== 配置与工具 ===================== */

function load_config(): array
{
    $file = getenv('RELAY_CONFIG') ?: '';
    if ($file === '' && is_file(getcwd() . '/config/binlog2redis.php')) {
        $file = getcwd() . '/config/binlog2redis.php';
    }
    if ($file === '' && is_file(RELAY_ROOT . '/config/binlog2redis.php')) {
        $file = RELAY_ROOT . '/config/binlog2redis.php';
    }
    if ($file === '' || !is_file($file)) {
        fwrite(STDERR, "找不到配置 config/binlog2redis.php，可用 RELAY_CONFIG 指定\n");
        exit(1);
    }
    return require $file;
}

function make_logger(array $config): Logger
{
    return new Logger(
        (string)($config['log']['level'] ?? 'info'),
        (string)($config['log']['file'] ?? '')
    );
}

function make_store(array $config): StoreInterface
{
    $cfg = $config['checkpoint'];
    if (($cfg['driver'] ?? 'file') === 'redis') {
        return RedisStore::connect($cfg['redis'], (string)$cfg['key']);
    }
    return new FileStore((string)$cfg['file']['path'], (bool)($cfg['file']['fsync'] ?? false));
}

function make_positions(StoreInterface $store, Logger $logger, array $config): PositionManager
{
    $cfg = $config['checkpoint'];
    return new PositionManager(
        $store,
        $logger,
        (int)($cfg['every_events'] ?? 100),
        (float)($cfg['every_seconds'] ?? 1.0)
    );
}

function install_signals(object $runner): void
{
    if (!function_exists('pcntl_signal')) {
        return;
    }
    $handler = static function () use ($runner) {
        $runner->stop();
    };
    pcntl_signal(SIGTERM, $handler);
    pcntl_signal(SIGINT, $handler);
    pcntl_async_signals(true);
}

function parse_options(array $args): array
{
    $out = [];
    foreach ($args as $a) {
        if (str_starts_with($a, '--')) {
            $a = substr($a, 2);
            if (str_contains($a, '=')) {
                [$k, $v] = explode('=', $a, 2);
                $out[$k] = $v;
            } else {
                $out[$a] = true;
            }
        }
    }
    return $out;
}

function usage(): void
{
    echo <<<TXT
binlog2redis · binlog → Redis Stream 单文件服务

用法：
  binlog2redis start                    启动（Ctrl+C / SIGTERM 优雅退出）
  binlog2redis once --seconds=5         消费指定秒数后退出
  binlog2redis fullsync                 全量同步（快照现存数据，并记录起始位点）
  binlog2redis fullsync --dry-run       只列出待同步的表
  binlog2redis fullsync --tables=a,b    只同步指定表
  binlog2redis status                   查看点位
  binlog2redis reset-position --force   重置点位
  binlog2redis check                    MySQL / Redis / 点位 自检

配置：
  RELAY_CONFIG            配置文件路径，默认 ./config/binlog2redis.php

环境变量（覆盖配置）：
  RELAY_MYSQL_HOST / RELAY_MYSQL_PORT / RELAY_MYSQL_USER / RELAY_MYSQL_PASSWORD
  RELAY_SLAVE_ID          从库 ID，集群内必须唯一
  RELAY_DATABASES         只订阅的库，逗号分隔
  RELAY_TABLES            只订阅的表
  RELAY_ONLY_CONFIGURED   1 = 只处理 tables/columns 里配置过的表
  RELAY_REDIS_HOST / RELAY_REDIS_PORT / RELAY_REDIS_PASSWORD / RELAY_REDIS_DB
  RELAY_STREAM            目标 stream，默认 binlog:events
  RELAY_CHECKPOINT        file | redis
  RELAY_LOG_LEVEL         debug | info | warning | error

依赖：
  PHP 8.2+，扩展 sockets / bcmath / json / redis / pdo_mysql
  不需要 composer，也不需要 vendor 目录

TXT;
}
