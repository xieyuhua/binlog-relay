# 复制为 .env 后填写。所有变量都可以用系统环境变量覆盖。
RELAY_MYSQL_HOST=127.0.0.1
RELAY_MYSQL_PORT=3306
RELAY_MYSQL_USER=repl
RELAY_MYSQL_PASSWORD=
RELAY_SLAVE_ID=8811

# 只订阅业务库，逗号分隔；为空表示全部
RELAY_DATABASES=
RELAY_TABLES=

# 点位：file | redis
RELAY_CHECKPOINT=file
RELAY_CHECKPOINT_KEY=binlog_relay:checkpoint:default
RELAY_CHECKPOINT_EVERY=100
RELAY_CHECKPOINT_SECONDS=1.0

RELAY_REDIS_HOST=127.0.0.1
RELAY_REDIS_PORT=6379
RELAY_REDIS_PASSWORD=
RELAY_REDIS_DB=0

RELAY_BATCH_SIZE=200
RELAY_LOG_LEVEL=info
RELAY_LOG_FILE=
