# 复制为 config.yaml 后修改
mysql:
  host: 127.0.0.1
  port: 3306
  user: repl
  password: "CHANGE_ME"
  server_id: 8811        # 集群内必须唯一

filter:
  databases: [shop]
  emit_ddl: false

producer:
  type: redis
  redis:
    addr: 127.0.0.1:6379
    stream: binlog:events

checkpoint:
  driver: file
  path: var/checkpoint.json

# 多主题扇出示例（producer.type 为 redis/kafka/rabbitmq 时生效）
# topics:
#   - target: theme-a
#     tables: [orders]
#   - target: theme-b
#     tables: ["*"]
#     labels: {env: prod}

runtime:
  batch_size: 200
  fullsync_batch: 1000
  include_views: false   # 全量同步是否包含视图

alert:
  cooldown: 5m
  max_per_minute: 15
  wecom:
    key: ""
  dingtalk:
    token: ""
    secret: ""
    keyword: ""
